    &quot;chloride_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;chloride_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;chloride_mg_l&quot; 
    END,
    &quot;calcium_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;calcium_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;calcium_mg_l&quot; 
    END,
    &quot;doc_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;doc_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;doc_mg_l&quot; 
    END,
    &quot;toc_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;toc_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;toc_mg_l&quot; 
    END,
    &quot;tc_f&quot; = CASE 
        WHEN LOWER(TRIM(&quot;tc_f&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;tc_f&quot; 
    END,
    &quot;tc_uf&quot; = CASE 
        WHEN LOWER(TRIM(&quot;tc_uf&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;tc_uf&quot; 
    END,
    &quot;ic_f&quot; = CASE 
        WHEN LOWER(TRIM(&quot;ic_f&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;ic_f&quot; 
    END,
    &quot;ic_uf&quot; = CASE 
        WHEN LOWER(TRIM(&quot;ic_uf&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;ic_uf&quot; 
    END,
    &quot;tn_f&quot; = CASE 
        WHEN LOWER(TRIM(&quot;tn_f&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;tn_f&quot; 
    END,
    &quot;tn_uf&quot; = CASE 
        WHEN LOWER(TRIM(&quot;tn_uf&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;tn_uf&quot; 
    END,
    &quot;particlesize_um&quot; = CASE 
        WHEN LOWER(TRIM(&quot;particlesize_um&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
