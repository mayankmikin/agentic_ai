SET 
    &quot;conductivity_us&quot; = CASE 
        WHEN LOWER(TRIM(&quot;conductivity_us&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;conductivity_us&quot; 
    END,
    &quot;ammonium_nh4&quot; = CASE 
        WHEN LOWER(TRIM(&quot;ammonium_nh4&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;ammonium_nh4&quot; 
    END,
    &quot;nh4_n_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;nh4_n_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;nh4_n_mg_l&quot; 
    END,
    &quot;no3_n_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;no3_n_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;no3_n_mg_l&quot; 
    END,
    &quot;no2_n_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;no2_n_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
        ELSE &quot;no2_n_mg_l&quot; 
    END,
    &quot;sodium_mg_l&quot; = CASE 
        WHEN LOWER(TRIM(&quot;sodium_mg_l&quot;)) IN ('n.a.', 'na', 'n/a', 'none', 'null', '-', '', 'nd') THEN NULL 
